# Скопируйте этот файл в .env и заполните своими значениями
# Подробнее, где взять каждый токен: TOKENS.md

# SonarQube (сервис sonarqube из docker-compose.yml)
# Токен создаётся после первого запуска: http://localhost:9000 →
# My Account → Security → Generate Tokens (тип User Token)
SONAR_URL=http://localhost:9000
SONAR_TOKEN=
PROJECT_KEY=TechDebtManager

# GigaChat API
# Authorization key из проекта GigaChat API в личном кабинете Studio:
# https://developers.sber.ru/studio → проект → Настройки API → Получить ключ
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2-Max

# Токен GitHub/GitLab для приватных репозиториев (опционально)
# GitHub: Settings → Developer settings → Personal access tokens, scope repo
# GitLab: User settings → Access tokens, scope read_repository
GIT_TOKEN=

# Репозиторий по умолчанию (опционально)
REPO_URL=

# CloudPub: публикация дашборда с личного ПК (опционально)
# API-токен с главной страницы личного кабинета https://cloudpub.ru/dashboard
CLOUDPUB_TOKEN=
