# Скопируйте этот файл в .env и заполните своими значениями

# SonarQube (сервис sonarqube из docker-compose.yml)
# Токен создаётся после первого запуска: My Account → Security → Generate Tokens
SONAR_URL=http://localhost:9000
SONAR_TOKEN=
PROJECT_KEY=TechDebtManager

# GigaChat API
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2-Max

# Токен GitHub/GitLab для приватных репозиториев (опционально)
GIT_TOKEN=

# Репозиторий по умолчанию (опционально)
REPO_URL=
